{
	"info": {
		"_postman_id": "api-tests",
		"name": "API Endpoints Tests",
		"description": "Collection for testing all API endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication Tests",
			"item": [
				{
					"name": "User Registration",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"test@example.com\",\n    \"password\": \"Test@123\",\n    \"role\": \"student\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/signup",
							"host": ["{{base_url}}"],
							"path": ["auth", "signup"]
						},
						"description": "Test user registration endpoint"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Registration successful', function () {",
									"    pm.response.to.have.status(200);",
									"    const response = pm.response.json();",
									"    pm.expect(response).to.have.property('success', true);",
									"    pm.expect(response).to.have.property('token').that.is.a('string');",
									"    if (response.token) {",
									"        pm.environment.set('auth_token', response.token);",
									"    }",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "User Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"Test@123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						},
						"description": "Test user login endpoint"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Login successful', function () {",
									"    pm.response.to.have.status(200);",
									"    const response = pm.response.json();",
									"    pm.expect(response).to.have.property('success', true);",
									"    pm.expect(response).to.have.property('token').that.is.a('string');",
									"    if (response.token) {",
									"        pm.environment.set('auth_token', response.token);",
									"    }",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Verify Token",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/verify",
							"host": ["{{base_url}}"],
							"path": ["auth", "verify"]
						},
						"description": "Test token verification endpoint"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Token verification successful', function () {",
									"    pm.response.to.have.status(200);",
									"    const response = pm.response.json();",
									"    pm.expect(response).to.have.property('success', true);",
									"    pm.expect(response).to.have.property('user').that.is.an('object');",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "Exam Management Tests",
			"item": [
				{
					"name": "Create Exam",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "name",
									"value": "Test Exam",
									"type": "text"
								},
								{
									"key": "duration",
									"value": "60",
									"type": "text"
								},
								{
									"key": "date",
									"value": "2024-03-20",
									"type": "text"
								},
								{
									"key": "active_start",
									"value": "2024-03-20T10:00:00Z",
									"type": "text"
								},
								{
									"key": "active_end",
									"value": "2024-03-20T12:00:00Z",
									"type": "text"
								},
								{
									"key": "file",
									"type": "file",
									"src": "exam_questions.txt"
								},
								{
									"key": "studentData",
									"type": "file",
									"src": "students.xlsx"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/exam/create",
							"host": ["{{base_url}}"],
							"path": ["exam", "create"]
						},
						"description": "Test exam creation endpoint"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Exam creation successful', function () {",
									"    pm.response.to.have.status(200);",
									"    const response = pm.response.json();",
									"    pm.expect(response).to.have.property('success', true);",
									"    pm.expect(response).to.have.property('examId').that.is.a('string');",
									"    if (response.examId) {",
									"        pm.environment.set('exam_id', response.examId);",
									"    }",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Get Created Exams",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/exam/created?instructor={{instructor_username}}",
							"host": ["{{base_url}}"],
							"path": ["exam", "created"],
							"query": [
								{
									"key": "instructor",
									"value": "{{instructor_username}}"
								}
							]
						},
						"description": "Test getting created exams"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Get created exams successful', function () {",
									"    pm.response.to.have.status(200);",
									"    const response = pm.response.json();",
									"    pm.expect(response).to.have.property('success', true);",
									"    pm.expect(response).to.have.property('exams').that.is.an('array');",
									"});"
								]
							}
						}
					]
				}
			]
		},
